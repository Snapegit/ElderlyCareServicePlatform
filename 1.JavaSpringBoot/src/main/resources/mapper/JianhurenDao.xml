<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.JianhurenDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.JianhurenEntity" id="jianhurenMap">
        <result property="jianhurenzhanghao" column="jianhurenzhanghao"/>
        <result property="jianhurenmima" column="jianhurenmima"/>
        <result property="jianhurenxingming" column="jianhurenxingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="xingbie" column="xingbie"/>
        <result property="shoujihaoma" column="shoujihaoma"/>
        <result property="laorenzhanghao" column="laorenzhanghao"/>
        <result property="laorenxingming" column="laorenxingming"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.JianhurenView" >

		SELECT  jianhuren.* FROM jianhuren  jianhuren 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.JianhurenView" >
		SELECT * FROM jianhuren  jianhuren <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
