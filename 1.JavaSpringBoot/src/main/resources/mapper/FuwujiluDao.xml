<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.FuwujiluDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.FuwujiluEntity" id="fuwujiluMap">
        <result property="fuwumingcheng" column="fuwumingcheng"/>
        <result property="fuwudidian" column="fuwudidian"/>
        <result property="fuwuriqi" column="fuwuriqi"/>
        <result property="zhaopian" column="zhaopian"/>
        <result property="shipin" column="shipin"/>
        <result property="neirong" column="neirong"/>
        <result property="zhiyuanzhezhanghao" column="zhiyuanzhezhanghao"/>
        <result property="zhiyuanzhexingming" column="zhiyuanzhexingming"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.FuwujiluView" >

		SELECT  fuwujilu.* FROM fuwujilu  fuwujilu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.FuwujiluView" >
		SELECT * FROM fuwujilu  fuwujilu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
